rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Change this to the same email as ADMIN_EMAIL in config.js
    function adminEmail() { return 'owner@example.com'; }

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function isBootstrapAdmin() { return signedIn() && request.auth.token.email == adminEmail(); }
    function isAdmin() { return isBootstrapAdmin() || (hasProfile() && profile().role == 'admin' && profile().active == true); }
    function isActive() { return isBootstrapAdmin() || (hasProfile() && profile().active == true); }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }
    match /settings/{doc} {
      allow read: if isActive();
      allow write: if isAdmin();
    }
    match /invoices/{id} {
      allow read, create, update: if isActive();
      allow delete: if isAdmin();
    }
    match /parties/{id} { allow read, write: if isActive(); }
    match /items/{id}   { allow read, write: if isActive(); }
  }
}
